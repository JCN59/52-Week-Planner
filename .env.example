# Research + scripting (optional — the pipeline falls back to offline templates)
ANTHROPIC_API_KEY=
# Override the model used by the video agent (default: claude-opus-5)
VIDEO_AGENT_MODEL=

# B-roll generation (optional — falls back to local placeholder cards)
FAL_KEY=
FAL_VIDEO_MODEL=

# AI presenter (optional — falls back to a placeholder narrator card)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# How long to wait on a generation job before falling back (ms, default 240000)
VIDEO_GEN_TIMEOUT_MS=

# Where video projects are written (default: ./.data/video-projects)
VIDEO_DATA_DIR=
